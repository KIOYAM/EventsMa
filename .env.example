# ---------------------------------------------------------------------------
# EventsMa — environment template. Copy to .env.local. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project (Mumbai / ap-south-1). Server-side only.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public origin used to build quote links. Never derived from the request Host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments are manual. Bank/UPI details live in each business's settings, not
# here, and are shown on the public quotation. No gateway keys are needed.
# Razorpay env vars were removed when the gateway path was deleted.

# Transactional email
RESEND_API_KEY=""
RESEND_FROM="quotes@eventsma.in"

# Routing distance (optional: manual transport fallback works without it)
GOOGLE_ROUTES_API_KEY=""

# Ops
SENTRY_DSN=""
LOG_LEVEL="info"
